<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF050A07"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/ToolbarButton"
                android:layout_marginStart="0dp"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/settings_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.12"
                android:text="@string/settings_title"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- THEME -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/hdr_theme"
                style="@style/SectionHeader"
                android:text="@string/section_theme" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_theme_auto"
                    style="@style/DoomButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/theme_auto" />

                <Button
                    android:id="@+id/btn_theme_doom"
                    style="@style/DoomButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/theme_doom" />

                <Button
                    android:id="@+id/btn_theme_iron"
                    style="@style/DoomButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/theme_iron" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_theme_info"
                style="@style/BodyText"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- WALLPAPER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/hdr_wallpaper"
                style="@style/SectionHeader"
                android:text="@string/section_wallpaper" />

            <ImageView
                android:id="@+id/img_wallpaper_preview"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:background="#FF0B130E"
                android:contentDescription="@string/cd_wallpaper_preview"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/txt_wallpaper_status"
                style="@style/BodyText"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_wallpaper_choose"
                    style="@style/DoomButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/wallpaper_choose" />

                <Button
                    android:id="@+id/btn_wallpaper_restore"
                    style="@style/DoomButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wallpaper_restore" />
            </LinearLayout>
        </LinearLayout>

        <!-- AUDIO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/hdr_audio"
                style="@style/SectionHeader"
                android:text="@string/section_audio" />

            <TextView
                android:id="@+id/txt_audio_name"
                style="@style/BodyText"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_audio_choose"
                    style="@style/DoomButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/audio_choose" />

                <Button
                    android:id="@+id/btn_audio_remove"
                    style="@style/DoomButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/audio_remove" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_audio_play"
                    style="@style/DoomButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/audio_play" />

                <Button
                    android:id="@+id/btn_audio_stop"
                    style="@style/DoomButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/audio_stop" />
            </LinearLayout>

            <TextView
                android:id="@+id/lbl_volume"
                style="@style/BodyText"
                android:layout_marginTop="12dp"
                android:text="@string/audio_volume" />

            <SeekBar
                android:id="@+id/seek_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:minHeight="48dp" />

            <TextView
                android:id="@+id/txt_audio_note"
                style="@style/BodyText"
                android:layout_marginTop="4dp"
                android:text="@string/audio_note" />
        </LinearLayout>

        <!-- BATTERY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/hdr_battery"
                style="@style/SectionHeader"
                android:text="@string/section_battery" />

            <Switch
                android:id="@+id/switch_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/battery_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                style="@style/BodyText"
                android:layout_marginTop="4dp"
                android:text="@string/battery_desc" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_restore_defaults"
            style="@style/DoomButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/restore_defaults" />

        <TextView
            style="@style/BodyText"
            android:layout_marginTop="16dp"
            android:text="@string/about_text"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
