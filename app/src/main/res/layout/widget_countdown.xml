<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.16"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="#FF3DDC84" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_months" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="3" android:text="01" android:textColor="#FFC4F8D2"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="72sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:gravity="center" android:fontFamily="sans-serif-condensed" android:textStyle="bold" />
            <TextView android:id="@+id/w_lbl_months" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:text="@string/unit_months" android:textColor="#FF86BFA0"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp" android:maxLines="1" android:gravity="center|top"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.06" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.32" android:orientation="vertical">
            <TextView android:id="@+id/w_colon1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3"
                android:text=":" android:textColor="#FF3DDC84" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="60sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:gravity="center" android:fontFamily="sans-serif-condensed" android:textStyle="bold" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_days" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="3" android:text="10" android:textColor="#FFC4F8D2"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="72sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:gravity="center" android:fontFamily="sans-serif-condensed" android:textStyle="bold" />
            <TextView android:id="@+id/w_lbl_days" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:text="@string/unit_days" android:textColor="#FF86BFA0"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp" android:maxLines="1" android:gravity="center|top"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.06" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.32" android:orientation="vertical">
            <TextView android:id="@+id/w_colon2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3"
                android:text=":" android:textColor="#FF3DDC84" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="60sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:gravity="center" android:fontFamily="sans-serif-condensed" android:textStyle="bold" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_hours" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="3" android:text="02" android:textColor="#FFC4F8D2"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="72sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:gravity="center" android:fontFamily="sans-serif-condensed" android:textStyle="bold" />
            <TextView android:id="@+id/w_lbl_hours" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:text="@string/unit_hours" android:textColor="#FF86BFA0"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp" android:maxLines="1" android:gravity="center|top"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.06" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.32" android:orientation="vertical">
            <TextView android:id="@+id/w_colon3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3"
                android:text=":" android:textColor="#FF3DDC84" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="60sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:gravity="center" android:fontFamily="sans-serif-condensed" android:textStyle="bold" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2.5" android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3">
                <Chronometer android:id="@+id/w_mmss" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:textColor="#FFC4F8D2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="72sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:gravity="center" android:fontFamily="sans-serif-condensed" android:textStyle="bold" />
                <TextView android:id="@+id/w_mmss_static" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:text="00:00" android:textColor="#FFC4F8D2" android:visibility="gone" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="72sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:gravity="center" android:fontFamily="sans-serif-condensed" android:textStyle="bold" />
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/w_lbl_minutes" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                 android:text="@string/unit_minutes" android:textColor="#FF86BFA0"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp" android:maxLines="1" android:gravity="center|top"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.06" />
                <TextView android:id="@+id/w_lbl_seconds" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                 android:text="@string/unit_seconds" android:textColor="#FF86BFA0"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp" android:maxLines="1" android:gravity="center|top"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.06" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
